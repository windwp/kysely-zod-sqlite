{
  "name": "kysely-zod-sqlite",
  "version": "1.1.24",
  "description": "An flexible api for Cloudflare D1 and sqlite. It has an simple api of Prisma and a powerful query with Kysely. ",
  "main": "./dist/index.js",
  "type": "module",
  "files": [
    "dist/**/*",
    "driver/**/*"
  ],
  "scripts": {
    "prepack": "cp -r ./dist/driver ./driver",
    "build": "tsc --project tsconfig.build.json && npm run fix-esm-import-path",
    "fix-esm-import-path": "npx fix-esm-import-path ./dist/index.js && npx fix-esm-import-path ./dist/driver/*.js && node ./scripts/fix-esm-2.js",
    "clean": "rm -rf ./dist/",
    "cm": "cz",
    "lint": "eslint ./src/ --fix",
    "trace": "tsc --generateTrace trace --incremental false",
    "semantic-release": "semantic-release",
    "test": "vitest --hideSkippedTests",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windwp/kysely-zod-sqlite.git"
  },
  "license": "MIT",
  "author": {
    "name": "windwp",
    "email": "windwp@users.noreply.github.com",
    "url": "https://github.com/windwp"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./driver/sqlite-driver": {
      "types": "./dist/driver/sqlite-driver.d.ts",
      "import": "./dist/driver/sqlite-driver.js",
      "require": "./dist/driver/sqlite-driver.js"
    },
    "./driver/fetch-driver": {
      "types": "./dist/driver/fetch-driver.d.ts",
      "import": "./dist/driver/fetch-driver.js",
      "require": "./dist/driver/fetch-driver.js"
    },
    "./driver/d1-driver": {
      "types": "./dist/driver/d1-driver.d.ts",
      "import": "./dist/driver/d1-driver.js",
      "require": "./dist/driver/d1-driver.js"
    }
  },
  "engines": {
    "node": ">=18.0"
  },
  "keywords": [
    "cloudflare",
    "kysely",
    "zod",
    "prisma",
    "edge",
    "sqlite",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/windwp/kysely-zod-sqlite/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/windwp/kysely-zod-sqlite",
  "config": {
    "commitizen": {
      "path": "./node_modules/@ryansonshine/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.ts": "eslint --cache --cache-location .eslintcache --fix"
  },
  "release": {
    "branches": [
      "release"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "type": "build",
              "scope": "deps",
              "release": "patch"
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "build",
                "section": "Dependencies and Other Build Updates",
                "hidden": false
              }
            ]
          }
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "dependencies": {
    "date-fns": "4.2.1",
    "kysely": "^0.27.6",
    "loglevel": "^1.9.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260522.1",
    "@eslint/js": "^9.39.4",
    "@ryansonshine/commitizen": "^4.2.8",
    "@ryansonshine/cz-conventional-changelog": "^3.3.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejson": "^2.2.2",
    "@types/flat": "^5.0.5",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "@types/pg-cursor": "^2.7.2",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "better-sqlite3": "^11.10.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-unix": "^8.40.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "fix-esm-import-path": "^1.10.3",
    "globals": "^15.15.0",
    "lint-staged": "^15.5.2",
    "pg": "^8.21.0",
    "pg-cursor": "^2.20.0",
    "prettier": "^3.8.3",
    "semantic-release": "^24.2.9",
    "ts-node": "^10.9.2",
    "tsd": "^0.31.2",
    "type-fest": "^4.41.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^3.2.4"
  }
}
